# Vorlage: als "config.env" kopieren und ausfüllen. config.env ist gitignored.
#
#   cp config.example.env config.env && $EDITOR config.env

# --- Apple TV ---
# IP oder Hostname des Apple TV (mDNS: "<name>.local")
ATV_HOST=appletv.local
# Name des Apple TV in mDNS (z. B. "Wohnzimmer"); leer = erstbestes Gerät
ATV_NAME=
# UDID des Apple TV (findet man mit: avahi-browse -rt _remoted._tcp)
ATV_UDID=
# Pairing-Port; leer lassen = automatisch per avahi-browse ermitteln
ATV_PAIRING_PORT=

# --- Apple-Entwickler / Signierung ---
# Team-ID des (kostenlosen) Apple-ID-Accounts
TEAM_ID=
# Bundle-Identifier für die signierte App
BUNDLE_ID=
# Apple-ID, die zum Signieren benutzt wird (ungenutzter Zweitaccount empfohlen)
APPLE_ID=

# --- Pfade (relativ zum Repo-Verzeichnis, Standardwerte sind ok) ---
# PLUMESIGN=bin/plumesign
# PAIRING_FILE=rp_pairing_file.plist
# KEYS_DIR=keys
# WORKDIR=.
